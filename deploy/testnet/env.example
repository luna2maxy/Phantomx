# Copy to /etc/phantomx/testnet.env on each VPS and fill secrets.
PHANTOMX_NETWORK=testnet
PHANTOMX_CONFIG=/etc/phantomx/testnet.node.env
PHANTOMX_DATADIR=/var/lib/phantomx
PHANTOMX_RPC_HOST=127.0.0.1
PHANTOMX_RPC_PORT=18740
PHANTOMX_P2P_HOST=0.0.0.0
PHANTOMX_P2P_PORT=18742
PHANTOMX_RPC_TOKEN=CHANGE_ME_LONG_RANDOM
PHANTOMX_RPC_ALLOWIP=127.0.0.1
PHANTOMX_NODE_INDEX=1
PHANTOMX_PEERS=

# Pool
PHANTOMX_POOL_LISTEN=127.0.0.1:8750
PHANTOMX_POOL_API_LISTEN=127.0.0.1:8751
PHANTOMX_POOL_API_TOKEN=CHANGE_ME_LONG_RANDOM
