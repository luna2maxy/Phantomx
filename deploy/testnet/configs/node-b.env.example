# VPS B / Node B instance
# Canonical BFT testnet config (PB-001): testnet-bft-canonical.json
PHANTOMX_NETWORK=testnet
PHANTOMX_CONFIG=/etc/phantomx/testnet-bft-canonical.json
PHANTOMX_DATADIR=/var/lib/phantomx/node-b
PHANTOMX_RPC_HOST=127.0.0.1
PHANTOMX_RPC_PORT=18740
PHANTOMX_P2P_HOST=0.0.0.0
PHANTOMX_P2P_PORT=18742
PHANTOMX_NODE_INDEX=2
PHANTOMX_CONNECT=VPS_A_IP:18742
PHANTOMX_RPC_TOKEN=CHANGE_ME_LONG_RANDOM
PHANTOMX_RPC_ALLOWIP=127.0.0.1
PHANTOMX_LOG_LEVEL=info
PHANTOMX_BFT_SIGNING_KEY_FILE=/etc/phantomx/keys/node-b.key
